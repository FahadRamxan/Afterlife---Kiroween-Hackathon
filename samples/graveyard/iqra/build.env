# Read by toolchain/build.sh, compile.sh and test.sh.
EXE=IQRA.EXE
LIBS="dbf3 screen ui kbd"
SOURCES="src/iqra.c src/collect.c src/lists.c src/rules.c"
# DBF header date of the seed files (YYYYMMDD).
SEED_DATE=20010301
# Default DOS clock for the scenarios: Monday 12 March 2001.
DOS_TIME="2001-03-12 10:00:00"
