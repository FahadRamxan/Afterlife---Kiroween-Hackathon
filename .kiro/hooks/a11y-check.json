{
  "version": "v1",
  "hooks": [
    {
      "name": "a11y-check",
      "trigger": "PostFileSave",
      "description": "When an apps/web page.tsx is saved, run the axe Playwright check on that page's route.",
      "matcher": "apps[\\\\/]web[\\\\/]app[\\\\/](.+[\\\\/])?page\\.tsx$",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/run.mjs a11y-check",
        "timeout": 300
      }
    }
  ]
}
