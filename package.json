{
  "name": "afterlife",
  "version": "0.0.0",
  "private": true,
  "description": "Software that outlives its source code.",
  "license": "MIT",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "vitest run",
    "e2e": "turbo run e2e",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "format": "prettier --write .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm e2e",
    "prepare": "husky",
    "test:coverage": "vitest run --coverage",
    "test:pbt": "node scripts/ci-local.mjs --only test",
    "snapshots:linux": "node scripts/update-linux-snapshots.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "graveyard:build": "node scripts/graveyard.mjs build",
    "graveyard:test": "node scripts/graveyard.mjs test",
    "graveyard:update": "node scripts/graveyard.mjs update",
    "graveyard:publish": "tsx scripts/graveyard-publish.ts",
    "dbf:golden": "tsx scripts/dbf-golden.ts",
    "screenshots": "pnpm --filter @afterlife/e2e screenshots",
    "screen:capture": "tsx scripts/screen-capture.ts",
    "mcp:gif": "tsx scripts/mcp-gif.ts",
    "db:migrate": "pnpm --filter @afterlife/db migrate",
    "db:migrate:down": "pnpm --filter @afterlife/db migrate:down",
    "db:seed": "pnpm --filter @afterlife/db seed",
    "db:generate": "pnpm --filter @afterlife/db generate"
  },
  "devDependencies": {
    "@afterlife/db": "workspace:^",
    "@afterlife/dbf": "workspace:^",
    "@afterlife/emulator": "workspace:^",
    "@afterlife/mcp-emulator": "workspace:^",
    "@afterlife/screen": "workspace:^",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/lint": "^21.2.4",
    "@commitlint/load": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.2",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
