node_modules/
.next/
dist/
# The DOS sample EXEs are committed: the js-dos bundles need them and Vercel cannot compile them.
# pnpm graveyard:test fails if this folder differs from a fresh build.
!samples/graveyard/dist/
coverage/
.turbo/
*.tsbuildinfo
playwright-report/
test-results/
.DS_Store
*.log
.vercel

# Env files hold secrets. Only the examples are committed.
.env
.env.*
!.env.example

# Local record of real Kiro hook firings (see docs/kiro-usage.md).
.kiro/.hook-runs.jsonl
# Personal editor settings (for example Kiro chat auto-approve). Never shared.
.vscode/
# js-dos, copied from node_modules by apps/web/scripts/copy-jsdos.mjs.
apps/web/public/js-dos/
# The reborn app's service worker, built by Serwist from apps/web/app/sw.ts.
apps/web/public/sw*
apps/web/public/swe-worker*
