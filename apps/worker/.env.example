# Copy to .env for local runs. Never commit .env.
DATABASE_URL=postgres://postgres:afterlife@localhost:5432/afterlife
# The language model: bedrock (Claude through the Converse API), anthropic (the Claude API), or none.
LLM_PROVIDER=none
# For bedrock: the region and a model or inference profile (default: Claude Sonnet 5.5, us. profile).
# Credentials come from the usual AWS chain (AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, a profile, or a role).
AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
# For anthropic: the Claude API key (secret: never commit or log it), and optionally another model
# (default: claude-sonnet-5-5). pnpm llm:smoke makes one tiny call to check them.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_ID=claude-sonnet-5-5
# How hard Claude thinks before it answers: low (default), medium, high, xhigh, max, or none for the
# model's own default. Thinking counts toward each call's token limit; low suits our short calls.
# ANTHROPIC_EFFORT=low
# Model tokens one project may use. Keep equal to the API's.
LLM_TOKEN_BUDGET=200000
# Possession: at most this many actions, and this many values per field (the first, then probes).
POSSESS_MAX_ACTIONS=120
POSSESS_PROBES=3
# The proof (Prompt 70): cases per proof, and old apps (emulators) at once.
PROVE_CASES=50
PROVE_LANES=2
# Signs Rebirth Certificates (Prompt 71): 32 bytes of hex, secret. Make one with
# `pnpm cert:key`; give the API its public key (CERT_PUBLIC_KEY). Unset: no certificates.
CERT_SIGNING_KEY=
# Speech to text for séance voice notes (Prompt 80): none or transcribe (Amazon Transcribe, in
# AWS_REGION; it has no Urdu, so spoken Urdu goes as Hindi, hi-IN). Each recording stays in the
# bucket only until it is transcribed. Optional: SPEECH_FALLBACK_REGION and
# TRANSCRIBE_FALLBACK_BUCKET, a second region tried when the first fails.
SPEECH_PROVIDER=none
TRANSCRIBE_BUCKET=
