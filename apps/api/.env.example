# Copy to .env for local runs. Never commit .env.
PORT=4000
HOST=0.0.0.0
# Comma-separated web origins allowed by CORS.
WEB_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# 1 behind a proxy that sets X-Forwarded-For (Render), so per-IP rate limits see the real address.
TRUST_PROXY=0
# Local: docker run -e POSTGRES_PASSWORD=afterlife -p 5432:5432 postgres:16. Prod: the Neon pooled URL.
DATABASE_URL=postgres://postgres:afterlife@localhost:5432/afterlife
# The most séance data kept in all, in MB (Neon's free plan holds 0.5 GB for everything).
SEANCE_STORAGE_MB=200
# Model tokens one project may use (the worker spends them; Show your work shows them). Keep equal to the worker's.
LLM_TOKEN_BUDGET=200000
# The Rebirth Certificates' public key (Prompt 71), published at /.well-known/afterlife-key.
# `pnpm cert:key` makes the pair; the worker gets the secret. Unset: no certificates.
CERT_PUBLIC_KEY=
# Ghost Twin's switch-over rule (Prompt 78): days of shadow use, matched transactions, open mismatches.
TWIN_READY_DAYS=7
TWIN_READY_MATCHED=200
TWIN_READY_MISMATCHES=0
# Requests per minute from one address, and new projects, seances and Souls per minute.
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_CREATE_PER_MINUTE=20
