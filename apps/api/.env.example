# Copy to .env for local runs. Never commit .env.
PORT=4000
HOST=0.0.0.0
# Comma-separated web origins allowed by CORS.
WEB_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# 1 behind a proxy that sets X-Forwarded-For (Render), so per-IP rate limits see the real address.
TRUST_PROXY=0
# Local: docker run -e POSTGRES_PASSWORD=afterlife -p 5432:5432 postgres:16. Prod: the Neon pooled URL.
DATABASE_URL=postgres://postgres:afterlife@localhost:5432/afterlife# The most séance data kept in all, in MB (Neon's free plan holds 0.5 GB for everything).
SEANCE_STORAGE_MB=200
